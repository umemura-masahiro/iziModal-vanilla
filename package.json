{
  "name": "izimodal-vanilla",
  "version": "2.0.0-beta.1",
  "publishConfig": {
    "access": "restricted"
  },
  "description": "Elegant, responsive, flexible and lightweight modal plugin with Vanilla JavaScript (no jQuery required).",
  "type": "module",
  "main": "./dist/iziModal.esm.js",
  "module": "./dist/iziModal.esm.js",
  "exports": {
    ".": {
      "import": "./dist/iziModal.esm.js",
      "default": "./dist/iziModal.esm.js"
    },
    "./css": "./css/iziModal.css",
    "./css/min": "./css/iziModal.min.css"
  },
  "files": [
    "dist",
    "css",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "izimodal",
    "vanilla-js",
    "modal",
    "lightbox",
    "iframe",
    "alert",
    "javascript",
    "js",
    "no-jquery",
    "es6",
    "esm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcelodolza/iziModal.git"
  },
  "author": {
    "name": "Marcelo Dolza",
    "email": "marcelodolza@gmail.com",
    "homepage": "https://dolza.dev"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/marcelodolza/iziModal/issues"
  },
  "homepage": "https://github.com/marcelodolza/iziModal#readme",
  "devDependencies": {
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@babel/core": "^7.23.5",
    "@babel/preset-env": "^7.23.5",
    "rollup": "^4.9.0"
  }
}
